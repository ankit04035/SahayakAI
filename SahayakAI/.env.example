# ==============================================================================
# SahayakAI - Environment Configuration Template
# Copy this file to '.env' and populate with valid credentials.
# Do NOT commit actual secrets or '.env' files to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=SahayakAI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage & File Uploads (Resume Analyzer) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- AI & LLM Providers ---
# Active provider selection: openai | gemini | huggingface | local
DEFAULT_AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Configuration (Optional / Open Models)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# --- RAG & Vector Database Configuration ---
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=data/vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Database Configuration (Application / Sessions) ---
DATABASE_URL=sqlite:///./data/sahayak.db
