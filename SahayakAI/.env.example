# ==============================================================================
# SahayakAI - Environment Configuration Template
# Copy this file to '.env' and adjust variables as needed.
# Do NOT commit actual secrets or '.env' files to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=SahayakAI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Foundation ---
DATABASE_URL=sqlite:///./data/sahayakai.db

# --- AI Provider Configuration ---
# Options: demo | openai | gemini
# Default is 'demo' mode so no API keys or external services are required for startup.
AI_PROVIDER=demo

# General AI Settings
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.2

# OpenAI / OpenAI-Compatible Configuration (Optional, not required for demo mode)
# Compatible with OpenAI, Ollama, vLLM, Groq, LMStudio
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Optional, not required for demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins (no '*' in production)
CORS_ORIGINS=http://localhost:5173

# --- Storage & Upload Limits ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Document Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Sentence Transformer & Embedding Settings (Step 6) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
# EMBEDDING_CACHE_DIR=./models/cache
