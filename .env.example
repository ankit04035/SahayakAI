# ==============================================================================
# SahayakAI - Environment Configuration Template
# Copy this file to '.env' and populate with valid credentials.
# Do NOT commit actual secrets or '.env' files to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=SahayakAI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins (React + Vite default: 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage & Safe File Uploads (Resume Analyzer) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- AI & LLM Providers ---
# Active provider selection: demo | openai | gemini
# Default is 'demo' mode so no external API keys or payments are required for startup.
DEFAULT_AI_PROVIDER=demo

# OpenAI / OpenAI-Compatible Configuration (Ollama, vLLM, LMStudio, Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- RAG & Vector Retrieval Configuration (Local NumPy Cosine Similarity) ---
VECTOR_STORAGE_TYPE=numpy
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.5

# --- Database Configuration (SQLAlchemy / SQLite) ---
DATABASE_URL=sqlite:///./data/sahayak.db
